# ============================
#     Identity And Access     
# ============================

AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=

# ======================
#     Shared Kernel     
# ======================

API_BASE_URL=http://127.0.0.1:8080
API_HTTP_HOST=127.0.0.1
API_HTTP_PORT=8080
API_HTTP_SCHEME=http
DATABASE_URL=postgresql://admin:password@localhost:5432/database

# Optional NestJS Observe telemetry. Set all four settings before enabling.
OBSERVE_ENABLED=false
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=nestjs-clean-boilerplate
# OBSERVE_ENDPOINT=https://observe-api.nestjs.com
