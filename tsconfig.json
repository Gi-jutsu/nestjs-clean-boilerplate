{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ESNext"
  },
  "include": [
    "specs/**/*.ts",
    "src/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}