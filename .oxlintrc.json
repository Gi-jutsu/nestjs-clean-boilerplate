{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "vitest": true
  },
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    "apps/**/build/**",
    "packages/**/build/**"
  ],
  "overrides": [
    {
      "files": ["*.spec.ts", "*.integration.spec.ts"],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    }
  ]
}
